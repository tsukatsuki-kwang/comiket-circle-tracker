{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Comiket Circle Tracker"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://script.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.melonbooks.co.jp/*"
  ],
  "background": {
    "scripts": [
      "src/utils/browser-poly.js",
      "src/utils/exporter.js",
      "background/service-worker.js"
    ],
    "service_worker": "background/service-worker.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "comiket-circle-tracker@comiketplanner.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "src/utils/browser-poly.js",
        "src/utils/parser.js",
        "src/utils/exporter.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
